{
  "name": "kyclius",
  "version": "2.7.1",
  "description": "A free, open-source, local-first AI desktop assistant you talk to out loud",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/copy-migrations.cjs && vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-migrations.cjs",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest",
    "electron:dev": "npm run build:main && npm run build:preload && concurrently \"npm:dev\" \"cross-env NODE_ENV=development npx electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^24.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.26",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^4.4.0"
  }
}
